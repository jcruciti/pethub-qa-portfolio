PUBLIC_BASE_URL=https://petstore.swagger.io
PUBLIC_API_BASE_URL=https://petstore.swagger.io/v2
SAUCE_DEMO_BASE_URL=https://www.saucedemo.com
# LOCAL_API_BASE_URL defaults to `<LOCAL_BASE_URL>/api`, so overriding the port
# needs only LOCAL_BASE_URL. Set it explicitly to split UI and API origins.
LOCAL_BASE_URL=http://127.0.0.1:3000
LOCAL_API_BASE_URL=http://127.0.0.1:3000/api
# Directory holding the three PetHub Local lowdb JSON stores. Defaults to
# `apps/pethub-local/data`. Override to give a run its own scratch storage so
# concurrent runs (e.g. two agent worktrees) never share database files.
PETHUB_DATA_DIR=
